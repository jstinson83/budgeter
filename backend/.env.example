# Copy to .env and fill in real values. Never commit .env.

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Web application).
# Authorized redirect URI for local dev: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Externally-visible base URL, used to build the OAuth callback URL.
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# HMAC key for session cookie signing. Any random string, e.g.:
#   openssl rand -hex 32
# Falls back to an insecure dev default if unset - fine locally, must be set
# anywhere this is actually reachable.
SESSION_SECRET=

# Optional
PORT=8080

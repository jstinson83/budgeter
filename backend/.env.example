# Copy to .env and fill in real values. Never commit .env.

# Single admin user credentials (this is a personal, single-user app for now)
BUDGETER_USERNAME=changeme
# Generate with: ./gradlew run --args="hash-password <your-password>"
BUDGETER_PASSWORD_HASH=

# Any random string, e.g. output of: openssl rand -hex 32
BUDGETER_SESSION_SECRET=

# Optional
PORT=8080
BUDGETER_FRONTEND_DIST=../frontend/dist
